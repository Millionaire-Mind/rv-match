# Copy this file to .env.local for local development.
# See README.md "Environment Variables" for where each value comes from.

# --- Database (required) ---------------------------------------------------
# Direct Postgres connection string. For local dev without Supabase, this
# points at the local `rvmatch_dev` Postgres database created by
# `npm run db:local:setup`. For a real deployment, use the Supabase
# project's connection string (Project Settings -> Database -> Connection
# string -> "URI", "Session" mode).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/rvmatch_dev

# --- Supabase (required for auth + storage in a real deployment) ----------
# From your Supabase project: Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Storage --------------------------------------------------------------
# Supabase Storage bucket used for photos and videos (created by
# supabase/migrations or manually in the dashboard). Defaults shown.
SUPABASE_STORAGE_BUCKET=rv-match-media

# --- App --------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Shows a small "Demo data" indicator in the dealer/admin dashboards. Set to
# "false" once you've replaced the seeded data with real dealers/inventory.
NEXT_PUBLIC_DEMO_MODE=true
# Random 32+ byte secret used to sign the anonymous session cookie.
SESSION_SECRET=replace-with-a-long-random-string

# --- Outbound email (optional) ---------------------------------------------
# If unset, RV Match uses a local development mail transport: emails are
# written to ./local-mail/*.json and logged to the console instead of being
# sent, so nothing is silently dropped and nothing fakes a real send.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="RV Match <no-reply@rvmatch.app>"

# --- Video generation --------------------------------------------------------
# Path to the ffmpeg binary. Defaults to "ffmpeg" (must be on PATH).
FFMPEG_PATH=ffmpeg
